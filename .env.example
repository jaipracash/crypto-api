# Set plan to "pro" and use a CoinGecko Pro key for a paid subscription.
COINGECKO_API_PLAN=demo
COINGECKO_API_KEY=

# The Pro API host is used for paid plans; Demo uses the public API host.
COINGECKO_BASE_URL=https://api.coingecko.com/api/v3

# Comma-separated browser origins. Use * for local development.
CORS_ORIGINS=*

# Optional SQLite path; defaults to app/crypto_research.db.
DATABASE_PATH=app/crypto_research.db
